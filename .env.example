# Copy to .env and replace the administrator key with a random secret.
# Leave LICENSE_DATABASE_URL empty to use SQLite for a single-server test.
LICENSE_DATABASE_URL=
LICENSE_DB_PATH=./data/licenses.sqlite3
# Example PostgreSQL URL: postgresql://licenseapi:change-me@127.0.0.1:5432/mql_license
LICENSE_ADMIN_API_KEY=replace-with-a-long-random-admin-secret
LICENSE_DEFAULT_GRACE_SECONDS=21600
